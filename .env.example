APP_ENV=production
APP_DEBUG=0
APP_URL=https://twoja-domena.pl
APP_TIMEZONE=Europe/Warsaw
APP_KEY=change-me-random-32chars

# Cyber_Folks / hosting wspoldzielony: zwykle host bazy to localhost albo adres z panelu.
DB_DSN=mysql:host=localhost;dbname=NAZWA_BAZY;charset=utf8mb4
DB_USER=UZYTKOWNIK_BAZY
DB_PASSWORD=HASLO_BAZY

# Token dla zadania CRON. Wygeneruj losowy ciag, np. 32+ znaki.
CRON_TOKEN=change-me-cron-token-32chars
CRON_BATCH_SIZE=25

# Token mostka/wtyczki Chrome dla portali, ktore wymagaja realnej sesji przegladarki.
KRZ_BRIDGE_TOKEN=change-me-bridge-token-32chars
KRZ_URL=https://portal-pub-prod.apps.ocp.prod.ms.gov.pl/
MSIG_URL=https://wyszukiwarka-msig.ms.gov.pl/
KRS_API_BASE=https://api-krs.ms.gov.pl/api/krs
MF_WHITELIST_BASE=https://wl-api.mf.gov.pl/api

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=DUiR
SMTP_TLS=1
REPORT_TO=

